---
interface Props {
  name: string;
  rating: number;
  outOf: number;
}

const { name, rating, outOf } = Astro.props;
const pct = Math.round((rating / outOf) * 100);
---

<div class="skillbar">
  <div class="skill-row">
    <span class="skill-name">{name}</span>
  </div>
  <div class="skill-track" role="img" aria-label={`${name}: ${rating} out of ${outOf}`}>
    <div class="skill-fill" style={`--skill-fill:${pct}%`}></div>
  </div>
</div>

<style>
  .skillbar {
    padding: var(--space-2) 0;
  }
  .skill-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.4rem;
    font-family: var(--font-sans);
  }
  .skill-name {
    font-size: 0.9rem;
    font-weight: 500;
  }
  .skill-track {
    height: 6px;
    border-radius: 999px;
    /* Faint green track (not --color-border-soft, which melds into the cream
       band); the solid fill still reads clearly against it. */
    background: var(--color-tag-bg);
    overflow: hidden;
  }
  .skill-fill {
    height: 100%;
    width: var(--skill-fill, 0);
    border-radius: 999px;
    background: var(--color-accent);
    transition: width 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
</style>
