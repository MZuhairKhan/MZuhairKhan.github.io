---
import { profile } from '../data/profile';
---

<section id="contact" class="section">
  <div class="container contact-inner">
    <h2 class="section-title">Get in touch</h2>
    <p>
      I'm always happy to discuss quantum technology, agentic AI, research opportunities, or interesting problems.
    </p>
    <div class="contact-buttons">
      <a class="button" href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="button button-ghost" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="button button-ghost" href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
      {profile.links.orcid && (
        <a class="button button-ghost" href={profile.links.orcid} target="_blank" rel="noopener">ORCID</a>
      )}
      {profile.links.scholar && (
        <a class="button button-ghost" href={profile.links.scholar} target="_blank" rel="noopener">Scholar</a>
      )}
      <a class="button button-ghost" href={profile.cvUrl} target="_blank" rel="noopener">CV ↗</a>
    </div>
  </div>
</section>

<style>
  .contact-inner p {
    max-width: 40rem;
    color: var(--color-soft);
  }
  .contact-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
