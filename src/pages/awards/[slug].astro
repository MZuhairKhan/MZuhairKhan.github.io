---
import RoleDetail from '../../components/RoleDetail.astro';
import { achievements } from '../../data/achievements';

export function getStaticPaths() {
  return achievements
    .filter((a) => a.slug)
    .map((a) => ({ params: { slug: a.slug }, props: { award: a } }));
}

const { award } = Astro.props;
const links = [
  ...(award.credlyUrl ? [{ label: 'Verify on Credly', url: award.credlyUrl }] : []),
  ...(award.repo ? [{ label: 'View code', url: award.repo }] : []),
  ...(award.projectId ? [{ label: 'View project', url: `/projects/${award.projectId}` }] : []),
  ...(award.links ?? []),
];
---

<RoleDetail
  title={`${award.title} — Mohammad Zuhair Khan`}
  description={award.description ?? award.title}
  role={award.title}
  context={award.result}
  org={award.org}
  orgUrl={award.url}
  detail={award.detail ?? award.description}
  heroImage={{ src: award.image, alt: award.title }}
  images={award.images}
  links={links}
  backHref="/#achievements"
  backLabel="Back to awards"
/>
