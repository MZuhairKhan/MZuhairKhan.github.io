---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';
---

<BaseLayout title={`Page not found — ${profile.fullName}`} description="The page you were looking for does not exist." noindex>
  <section class="section notfound">
    <div class="container">
      <p class="code">404</p>
      <h1 class="title">Page not found</h1>
      <p class="muted">The page you were looking for doesn’t exist or has moved.</p>
      <div class="links">
        <a class="button" href="/">Home</a>
        <a class="button button-ghost" href="/papers">Papers</a>
        <a class="button button-ghost" href={profile.cvUrl} target="_blank" rel="noopener">CV</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    border-top: none;
    text-align: center;
    padding: var(--space-16) 0;
  }
  .code {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(3rem, 12vw, 6rem);
    color: var(--color-accent);
    margin: 0;
    line-height: 1;
  }
  .title {
    margin: var(--space-3) 0 var(--space-2);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-6);
  }
</style>
