---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const projectLd = {
  '@context': 'https://schema.org',
  '@type': project.data.repo ? 'SoftwareSourceCode' : 'CreativeWork',
  name: project.data.title,
  description: project.data.description,
  author: { '@type': 'Person', name: 'Mohammad Zuhair Khan' },
  dateCreated: project.data.date.toISOString().slice(0, 10),
  url: new URL(`/projects/${project.id}`, Astro.site).href,
  keywords: project.data.tech.join(', '),
  ...(project.data.repo ? { codeRepository: project.data.repo } : {}),
  ...(project.data.thumb ? { image: new URL(project.data.thumb, Astro.site).href } : {}),
};

const projectUrl = new URL(`/projects/${project.id}`, Astro.site).href;
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: new URL('/projects', Astro.site).href },
    { '@type': 'ListItem', position: 3, name: project.data.title, item: projectUrl },
  ],
};
---

<BaseLayout title={`${project.data.title} — Mohammad Zuhair Khan`} description={project.data.description}>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(projectLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)} />
  </Fragment>
  <article class="section">
    <div class="container project-page">
      <a href="/projects" class="back-link">← Back to projects</a>

      <h1 class="project-title">{project.data.title}</h1>
      <p class="project-date">
        {project.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long' })}
      </p>

      {project.data.award && (
        <a class="project-award" href="/awards"><svg class="project-award-icon" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4h10v5a5 5 0 0 1-10 0V4Z"></path><path d="M7 5H4.5A1.5 1.5 0 0 0 3 6.5 3.5 3.5 0 0 0 6.5 10H7M17 5h2.5A1.5 1.5 0 0 1 21 6.5 3.5 3.5 0 0 1 17.5 10H17M9 21h6M12 14v7"></path></svg> {project.data.award}</a>
      )}

      {project.data.thumb && (
        <img class="project-thumb" src={project.data.thumb} alt={`${project.data.title} thumbnail`} width="800" height="500" decoding="async" fetchpriority="high" />
      )}

      <p class="project-description">{project.data.description}</p>

      {project.data.tech.length > 0 && (
        <div class="project-tech">
          {project.data.tech.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}

      <div class="project-links">
        {project.data.repo && <a class="button button-ghost" href={project.data.repo} target="_blank" rel="noopener">Repo ↗</a>}
        {project.data.demo && <a class="button button-ghost" href={project.data.demo} target="_blank" rel="noopener">Demo ↗</a>}
      </div>

      <section class="project-body">
        <Content />
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .project-page {
    max-width: 48rem;
  }
  .back-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    display: inline-block;
    margin-bottom: var(--space-6);
  }
  .project-title {
    margin: 0 0 var(--space-2) 0;
  }
  .project-date {
    font-family: var(--font-sans);
    color: var(--color-muted);
    font-size: 0.9rem;
    margin: 0 0 var(--space-6) 0;
  }
  .project-award {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 var(--space-6);
    padding: 0.25rem 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-accent-dark);
    background: var(--color-accent-bg);
    border-radius: 999px;
    text-decoration: none;
  }
  .project-thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    margin-bottom: var(--space-6);
  }
  .project-description {
    font-size: 1.1rem;
    color: var(--color-text);
  }
  .project-tech {
    margin: var(--space-4) 0;
  }
  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  .project-body {
    font-size: 1rem;
    line-height: 1.75;
  }
</style>
